# App
APP_ENV=local
NODE_ENV=local
APP_NAME=circl
APP_PORT=4000

# Datastores (docker-compose.yaml runs both locally)
DATABASE_URL=postgresql://admin:testpass@localhost:5432/circl
REDIS_URL=redis://localhost:6379

# Allowed CORS origins. Only enforced on staging and production.
CLIENT_URL=https://circl.com
ADMIN_CLIENT_URL=https://admin.circl.com

# JWT. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=14d
JWT_SIGNUP_SECRET=
JWT_SIGNUP_EXPIRY=15m

# Email, sent via Resend
EMAIL_FROM=
EMAIL_FROM_NAME=Circl
SUPPORT_EMAIL=
RESEND_API_KEY=

# AWS. One IAM user, S3 only. The region must be the bucket's own: a signature
# minted for another region is rejected as invalid rather than as misconfigured.
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Media. Bucket name only, no URL and no ARN. See docs/S3-SETUP.md.
MEDIA_BUCKET=
MEDIA_UPLOAD_URL_TTL_SECONDS=900

# Social sign-in
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
APPLE_BUNDLE_ID=
APPLE_JWKS_URI=https://appleid.apple.com/auth/keys

# Firebase, for push
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# OpenAI. Used only by the Commerce photo-to-draft feature.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024

# Startup behaviour on deploy
RUN_MIGRATIONS=true
RUN_SEED=false

# Set true only on extra instances, so one instance owns the schedule. Triggering
# a job by hand still works: POST /admin/jobs/{name}/run ignores this.
DISABLE_SCHEDULED_JOBS=false
