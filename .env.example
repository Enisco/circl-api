# App
APP_ENV=local
NODE_ENV=local
APP_NAME=circl
APP_PORT=4000

# Datastores (docker-compose.yaml runs both locally)
DATABASE_URL=postgresql://admin:testpass@localhost:5432/circl
REDIS_URL=redis://localhost:6379

# Allowed CORS origins. Only enforced on staging and production.
#
# NOTE: these two say circl.com, while the public website and every address on it
# use circl.app. One of them is wrong and it is not for this file to guess which:
# check the real deployment before copying these values anywhere.
CLIENT_URL=https://circl.com
ADMIN_CLIENT_URL=https://admin.circl.com
# The marketing site, whose forms are called from the visitor's browser. Comma-
# separated, because production serves it at both the apex and www and a browser
# treats those as two origins. Optional: leave empty where no site is deployed.
WEBSITE_URLS=https://circl.app,https://www.circl.app
# Where website submissions are emailed. Falls back to SUPPORT_EMAIL when empty.
WEBSITE_TEAM_EMAIL=

# JWT. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=14d
JWT_SIGNUP_SECRET=
JWT_SIGNUP_EXPIRY=15m

# Email, sent via Resend
EMAIL_FROM=
EMAIL_FROM_NAME=Circl
SUPPORT_EMAIL=
RESEND_API_KEY=

# AWS. One IAM user, S3 only. The region must be the bucket's own: a signature
# minted for another region is rejected as invalid rather than as misconfigured.
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Media. Bucket name only, no URL and no ARN. See docs/S3-SETUP.md.
MEDIA_BUCKET=
MEDIA_UPLOAD_URL_TTL_SECONDS=900

# Social sign-in
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
APPLE_BUNDLE_ID=
APPLE_JWKS_URI=https://appleid.apple.com/auth/keys

# Firebase Cloud Messaging, for push notifications.
#
# All three come from one file: Firebase console > Project settings > Service accounts >
# "Generate new private key". The JSON it downloads has project_id, client_email and private_key.
#
# FIREBASE_PRIVATE_KEY is multi-line. Paste it as ONE line wrapped in double quotes with the line
# breaks written as \n, exactly as the JSON file has them:
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
#
# All three are REQUIRED: the app refuses to boot without them rather than starting up and
# silently sending nothing (src/config/config.validation.ts).
#
# iOS needs one more thing, and it is not an environment variable: upload the APNs auth key (.p8)
# under Cloud Messaging in the same Firebase project. Without it, Android receives push and iOS
# does not, with no error on this side.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# OpenAI. Used only by the Commerce photo-to-draft feature.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024

# Startup behaviour on deploy
RUN_MIGRATIONS=true
# Reference data on boot: permissions, roles, cities, taxonomy, risk terms, support
# resources. All upserts, so it is safe on every boot and belongs on in production —
# the app cannot validate a code without its taxonomy, and Guard cannot scan without
# its lexicon. Unset also means true; it is written out here because this file is what
# a new environment gets copied from, and it previously said `false`.
RUN_SEED=true
# The Appendix B demo dataset on boot: ten invented members and everything they have
# done. Implies RUN_SEED. Refuses to run when NODE_ENV *or* APP_ENV is production, with
# no flag to override it. Never set this on anything a real member can reach.
RUN_DEMO_SEED=false

# Set true only on extra instances, so one instance owns the schedule. Triggering
# a job by hand still works: POST /admin/jobs/{name}/run ignores this.
DISABLE_SCHEDULED_JOBS=false

# Static store maps. Unset uses OpenStreetMap community tiles, which need no account.
# Set to mapbox or google with MAP_API_KEY for a provider you pay for, or template with
# MAP_STATIC_URL_TEMPLATE for anything else. The key stays here so it never reaches an app binary.
MAP_PROVIDER=
MAP_API_KEY=
MAP_STATIC_URL_TEMPLATE=
MAP_TILE_URL_TEMPLATE=

# ── Admin portal ────────────────────────────────────────────────────────────
# ADMIN_JWT_ACCESS_SECRET: >= 48 random bytes, and NOT the same value as JWT_ACCESS_SECRET.
# ADMIN_TOTP_ENC_KEY: exactly 32 bytes, base64. Encrypts staff TOTP secrets at rest.
# ADMIN_BFF_SECRET: >= 32 random bytes. The admin API refuses requests without it.
ADMIN_JWT_ACCESS_SECRET=
ADMIN_TOTP_ENC_KEY=
ADMIN_TOTP_ENC_KEY_ID=
ADMIN_BFF_SECRET=
ADMIN_HIBP_CHECK=
OPENAI_MODERATION_ENABLED=
ADMIN_BFF_SECRET_PREVIOUS=
