# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=local
APP_PORT=4000
APP_NAME=circl
NODE_ENV=local

# ---------------------------------------------------------------------------
# Datastores (see docker-compose.yaml for local containers)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://admin:testpass@localhost:5432/circl
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Clients / CORS origins
# ---------------------------------------------------------------------------
CLIENT_URL=https://circl.com
ADMIN_CLIENT_URL=https://admin.circl.com

# ---------------------------------------------------------------------------
# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=14d

JWT_SIGNUP_SECRET=
JWT_SIGNUP_EXPIRY=15m

# ---------------------------------------------------------------------------
# Social auth
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

APPLE_BUNDLE_ID=
APPLE_JWKS_URI=https://appleid.apple.com/auth/keys

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Must be from a domain verified in Resend dashboard (https://resend.com/domains)
# Use onboarding@resend.dev only for local testing (delivers to Resend account owner only)
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Circl
SUPPORT_EMAIL=

RESEND_API_KEY=

# ---------------------------------------------------------------------------
# AWS (SES email provider)
# ---------------------------------------------------------------------------
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Firebase Cloud Messaging (push notifications)
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024

RUN_MIGRATIONS=true
RUN_SEED=false

# ---------------------------------------------------------------------------
# Media storage (S3)
# ---------------------------------------------------------------------------
# MEDIA_BUCKET is the switch. Set it and uploads are presigned straight to S3,
# so the bytes go from the device to the bucket and never through this API.
# Leave it blank and the API falls back to a local-disk driver that serves the
# identical two-step upload contract. That fallback is for local development
# only: on Render the filesystem is ephemeral, so anything written there is gone
# on the next deploy.
MEDIA_BUCKET=
# The region the bucket lives in. Falls back to AWS_REGION when blank.
MEDIA_REGION=
# CDN or custom domain in front of the bucket, without a trailing slash, e.g.
# https://cdn.circl.app. When blank, media URLs point at the bucket directly,
# which works but is slower and exposes the bucket name.
MEDIA_CDN_URL=
# Credentials for the bucket. Leave both blank to reuse AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY, or set them to give media its own IAM user. Separate
# keys are worth it: the media user needs only PutObject, GetObject, HeadObject
# and DeleteObject on this one bucket, whereas the SES user needs none of that.
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
# How long a presigned upload URL stays valid, in seconds. Long enough for a
# 100MB video on a slow connection, short enough that a leaked URL expires.
MEDIA_UPLOAD_URL_TTL_SECONDS=900
# Local-disk driver only, ignored once MEDIA_BUCKET is set.
MEDIA_LOCAL_DIR=./storage/media
# Absolute origin this API is reachable at. Used to build media URLs for the
# local driver, so they open from a device rather than only from the host.
PUBLIC_BASE_URL=

# Set to "true" to stop this instance running the scheduled jobs (auto-completing
# bookings, expiring enquiries, sweeping orphaned uploads, rebuilding the Pulse
# dashboards). Useful when running more than one instance, since the jobs are
# per-process. Every job is idempotent, so a double-run is harmless.
DISABLE_SCHEDULED_JOBS=
