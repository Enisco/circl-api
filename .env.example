# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=local
APP_PORT=4000
APP_NAME=circl
NODE_ENV=local

# ---------------------------------------------------------------------------
# Datastores (see docker-compose.yaml for local containers)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://admin:testpass@localhost:5432/circl
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Clients / CORS origins
# ---------------------------------------------------------------------------
CLIENT_URL=https://circl.com
ADMIN_CLIENT_URL=https://admin.circl.com

# ---------------------------------------------------------------------------
# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=14d

JWT_SIGNUP_SECRET=
JWT_SIGNUP_EXPIRY=15m

# ---------------------------------------------------------------------------
# Social auth
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

APPLE_BUNDLE_ID=
APPLE_JWKS_URI=https://appleid.apple.com/auth/keys

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Must be from a domain verified in Resend dashboard (https://resend.com/domains)
# Use onboarding@resend.dev only for local testing (delivers to Resend account owner only)
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Circl
SUPPORT_EMAIL=

RESEND_API_KEY=

# ---------------------------------------------------------------------------
# AWS (SES email provider)
# ---------------------------------------------------------------------------
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Firebase Cloud Messaging (push notifications)
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024

RUN_MIGRATIONS=true
RUN_SEED=false

# ─── Media storage ────────────────────────────────────────────────────────────
# Set MEDIA_BUCKET to presign uploads straight to S3. Left blank, the API falls
# back to a local-disk driver that serves the identical two-step upload contract
# — fine for local development, but the files do not survive a redeploy.
MEDIA_BUCKET=
MEDIA_CDN_URL=
MEDIA_LOCAL_DIR=./storage/media
# Absolute origin this API is reachable at, used to build media URLs.
PUBLIC_BASE_URL=
