// ═══════════════════════════════════════════════════════════════════ Admin portal — staff identity
//
// A staff member is an ordinary `User` row with `isStaff = true` and a staff role, plus the three
// models here. Not a separate table: staff already appear as foreign keys in a dozen places
// (`ModerationQueueItem.assignedTo`, `GuardThread.assignedTo`, `ModerationAction.actor`,
// `ConversationParticipant`), and a parallel admin table would break every one of those relations.
//
// The corollary is that member authentication must refuse `isStaff` rows and admin authentication
// must refuse everything else. Both directions are enforced, because either gap alone is a way in.

/// Everything needed to prove a staff member is who they say they are. One row per staff account,
/// keyed by the user: there is no such thing as two sets of credentials for one person.
model AdminCredential {
  userId String @id @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// argon2id, PHC string format — so the parameters travel with the hash and can be raised later
  /// without invalidating anybody's password.
  passwordHash      String   @map("password_hash")
  passwordUpdatedAt DateTime @map("password_updated_at") @db.Timestamptz

  /// base64(iv | tag | ciphertext), AES-256-GCM. `keyId` travels with it so the key can rotate
  /// without a migration that would have to decrypt every row at once.
  totpSecretEnc    String?   @map("totp_secret_enc")
  totpKeyId        String?   @map("totp_key_id")
  totpEnabledAt    DateTime? @map("totp_enabled_at") @db.Timestamptz
  /// The last time step accepted. A code is refused if its step is not greater, which is what stops
  /// a code read over somebody's shoulder being used again inside its own 30-second window.
  totpLastUsedStep BigInt?   @map("totp_last_used_step")

  failedAttempts    Int       @default(0) @map("failed_attempts")
  failedMfaAttempts Int       @default(0) @map("failed_mfa_attempts")
  /// Drives the lock duration: each lock doubles the last one, so a patient attacker gets slower
  /// rather than merely interrupted.
  lockCount         Int       @default(0) @map("lock_count")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz

  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  lastLoginIp  String?   @map("last_login_ip")
  lastActiveAt DateTime? @map("last_active_at") @db.Timestamptz

  deactivatedAt   DateTime? @map("deactivated_at") @db.Timestamptz
  deactivatedById String?   @map("deactivated_by_id")
  invitedById     String?   @map("invited_by_id")

  /// Bumped by every credential reset, deactivation, reactivation, role change and invite
  /// acceptance. Setup tokens carry the epoch they were issued under, so a token obtained before a
  /// "reset both" for a suspected compromise cannot still activate the account afterwards.
  credentialEpoch Int @default(0) @map("credential_epoch")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  recoveryCodes AdminRecoveryCode[]

  @@map("admin_credentials")
}

/// Ten single-use codes, shown once. Hashed with argon2id like a password, because that is what
/// they are: a second credential that gets written on paper and photographed.
model AdminRecoveryCode {
  id         String          @id @default(uuid())
  userId     String          @map("user_id")
  credential AdminCredential @relation(fields: [userId], references: [userId], onDelete: Cascade)

  codeHash String    @map("code_hash")
  usedAt   DateTime? @map("used_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@map("admin_recovery_codes")
}

/// One sign-in. The refresh token is opaque and stored as a SHA-256 hash — a high-entropy secret,
/// so a fast hash is the right one, and a slow one would be a lie about what is being protected.
model AdminSession {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash         String?   @unique @map("refresh_token_hash")
  /// The hash rotation replaced, kept for the grace window and for reuse detection: a token that
  /// matches this outside the window means somebody is replaying a stolen one, and the session goes.
  previousRefreshTokenHash String?   @map("previous_refresh_token_hash")
  rotatedAt                DateTime? @map("rotated_at") @db.Timestamptz

  ip        String @map("ip")
  userAgent String @map("user_agent")

  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt        DateTime @default(now()) @map("last_used_at") @db.Timestamptz
  /// Twelve hours from the second factor, never extended by a refresh. A shift, not a tenancy.
  absoluteExpiresAt DateTime @map("absolute_expires_at") @db.Timestamptz

  revokedAt     DateTime?                 @map("revoked_at") @db.Timestamptz
  revokedReason AdminSessionRevokeReason? @map("revoked_reason")
  revokedById   String?                   @map("revoked_by_id")

  @@index([userId, revokedAt])
  @@index([previousRefreshTokenHash])
  @@map("admin_sessions")
}

/// The only way a staff account comes into existence. There is no self-service sign-up and no
/// password reset by email: both would make a staff inbox sufficient to become an administrator.
model AdminInvite {
  id     String @id @default(uuid())
  email  String @map("email")
  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id])

  tokenHash   String   @unique @map("token_hash")
  invitedById String   @map("invited_by_id")
  expiresAt   DateTime @map("expires_at") @db.Timestamptz

  /// The first send plus at most two resends. An invite that has been sent three times and not
  /// accepted is a conversation to have in person, not a fourth email.
  sendCount  Int      @default(1) @map("send_count")
  lastSentAt DateTime @default(now()) @map("last_sent_at") @db.Timestamptz

  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz
  acceptedUserId String?   @map("accepted_user_id")
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz
  revokedById    String?   @map("revoked_by_id")

  /// Set by reactivate and reset-credentials: the existing account this invite restores. An invite
  /// without one may only ever create a new account, so a stray invite cannot be aimed at somebody
  /// else's staff row.
  staffUserId String? @map("staff_user_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([email])
  @@index([staffUserId])
  @@map("admin_invites")
}

// ═══════════════════════════════════════════════════════════════════ Admin portal — audit
//
// Deliberately has no relation to `User`. The rows must outlive any account change and must never
// cascade: an audit trail that a deletion can edit is not one.

/// One row per staff action. Written in the same transaction as the change it describes, so there
/// is no state in which the change happened and the record of it did not.
model AuditLog {
  id         String   @id @default(uuid())
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  /// Null only for events with no authenticated actor: a failed login, a scheduled job, the
  /// bootstrap CLI.
  actorId        String? @map("actor_id")
  actorRole      String? @map("actor_role")
  actorSessionId String? @map("actor_session_id")

  action String    @map("action")
  area   AuditArea @map("area")

  targetType  String? @map("target_type")
  targetId    String? @map("target_id")
  /// A display snapshot for non-member targets. Null for members: their name is resolved from the
  /// live row at read time, so anonymising an account does not require rewriting history that
  /// must not be rewritable.
  targetLabel String? @map("target_label")

  before Json? @map("before")
  after  Json? @map("after")

  reasonCode    AdminReasonCode? @map("reason_code")
  policySubtype String?          @map("policy_subtype")
  reason        String?          @map("reason")

  metadata Json? @map("metadata")

  ip             String? @map("ip")
  userAgent      String? @map("user_agent")
  requestId      String? @map("request_id")
  idempotencyKey String? @map("idempotency_key")

  /// This row's own digest: SHA-256 over the canonical JSON of its recorded fields (S11.3).
  ///
  /// Written at insert and never read on the request path. On its own it proves little — anybody
  /// who could rewrite the row could rewrite the digest — which is why the evidence is the
  /// `AuditChainSegment` chain built over these digests. Null for rows written before the chain
  /// existed, which is what makes them visibly older than it rather than silently wrong.
  hash String? @map("hash")

  /// The chain's tip when this row was written: the hash of the newest segment sealed at the time.
  ///
  /// It anchors the row to history that was already sealed, so a row inserted later and backdated
  /// into a sealed era carries a tip that did not exist yet. Null until the first segment is
  /// sealed, and null if the tip could not be read — an unanchored row is still digested.
  prevHash String? @map("prev_hash")

  @@index([occurredAt])
  @@index([actorId, occurredAt])
  @@index([targetType, targetId, occurredAt])
  @@index([area, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_logs")
}

/// A sealed stretch of the audit trail, hashed (S11.3).
///
/// **Why a chain over segments rather than a `prevHash` on every row.** A per-row chain has to read
/// the previous row's hash and insert in one serialised step, or two concurrent actions read the
/// same tip and the chain forks. Serialising it means a lock held across the business transaction
/// that the audit row belongs to — a global queue through every admin mutation, and a deadlock
/// surface — for a control the spec marks *recommended, P3*. Sealing after the fact costs nothing
/// on the write path, covers the rows written before the chain existed, and detects the same thing:
/// any row changed, removed or inserted inside a sealed stretch breaks that segment's hash.
///
/// Each segment covers `(fromOccurredAt, toOccurredAt]` — contiguous with the one before it, so no
/// row can fall between two segments and go uncovered. `hash` is SHA-256 over the previous
/// segment's hash followed by the digest of every row in the range, in `(occurredAt, id)` order.
///
/// Append-only, by the same trigger as the trail itself: a chain the application can rewrite is a
/// chain that proves nothing about the application.
model AuditChainSegment {
  id  String @id @default(uuid())
  /// Insertion order, which is the chain's order. A gap means a rolled-back seal, not a missing
  /// link — the links are followed by hash, and `seq` only says which way is forward.
  seq BigInt @default(autoincrement()) @map("seq")

  /// Exclusive lower bound: the previous segment's `toOccurredAt`.
  fromOccurredAt DateTime @map("from_occurred_at") @db.Timestamptz
  /// Inclusive upper bound: where this seal stopped — a day on from the lower bound, the
  /// fifteen-minute cutoff, or where a fifty-thousand-row cap fell. **Not** the last row's
  /// timestamp, so consecutive ranges leave no gap for a late row to hide in.
  toOccurredAt   DateTime @map("to_occurred_at") @db.Timestamptz

  /// How many rows were in the range when it was sealed. The first thing verification compares.
  rowCount Int @map("row_count")

  /// The previous segment's `hash`. Null for the first segment, which is the chain's genesis.
  prevHash String? @map("prev_hash")
  hash     String  @map("hash")

  sealedAt DateTime @default(now()) @map("sealed_at") @db.Timestamptz

  /// When this segment was last recomputed and found intact. Nightly for the newest segments and
  /// on a rotation for the rest, so an edit to a two-year-old row is still found.
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz

  @@unique([seq])
  /// A predecessor is followed once and a stretch starts once. Both are invariants of the chain,
  /// declared here because two runs sealing at the same moment would otherwise fork it — and a
  /// forked chain reports a broken link for ever with no way to tell which branch is the history.
  @@unique([prevHash])
  @@unique([fromOccurredAt])
  @@index([toOccurredAt])
  @@index([hash])
  @@map("audit_chain_segments")
}

/// Why the hash chain does not start at the beginning any more (S11.4 against S11.3).
///
/// Audit rows are kept six years and then purged, which removes the stretches that sealed them —
/// and leaves the oldest remaining segment recording a predecessor that no longer exists.
/// Verification reports that as a broken link, deliberately: a chain that forgives a missing
/// genesis forgives a deleted one. This row is the explanation it accepts instead.
///
/// So the purge cannot quietly shorten the chain. It has to say, in a row of its own that nothing
/// can edit, which hash it removed and how much went with it — which is the same bargain the trail
/// itself makes: you may delete history on a schedule, but not without recording that you did.
model AuditChainTruncation {
  id String @id @default(uuid())

  /// The hash of the last segment removed: the value the oldest remaining segment still records as
  /// its predecessor, and the only thing that makes that record explicable.
  removedHash String @map("removed_hash")

  /// The end of the purged stretch — every entry up to here is gone.
  upToOccurredAt  DateTime @map("up_to_occurred_at") @db.Timestamptz
  segmentsRemoved Int      @map("segments_removed")
  rowsRemoved     Int      @map("rows_removed")

  purgedAt DateTime @default(now()) @map("purged_at") @db.Timestamptz

  @@index([removedHash])
  @@index([purgedAt])
  @@map("audit_chain_truncations")
}

// ═══════════════════════════════════════════════════════════════════ Admin portal — notes
//
/// A note staff leave each other about a member, a case, a thread or a deal.
///
/// Generic on purpose: one table and one pair of endpoints serve every subject, because the
/// alternative is six near-identical tables that drift. The subject is a type and an id rather than
/// a foreign key for the same reason the audit log has none — a note about a member must survive
/// that member being anonymised, and a note about a case must survive the case being closed.
///
/// Soft-deleted and audited. A note is somebody's judgement about a person, recorded where that
/// person cannot see it; a hard delete would make the record of who wrote what unrecoverable, and
/// that record is the only thing keeping the practice accountable.
model InternalNote {
  id          String          @id @default(uuid())
  subjectType NoteSubjectType @map("subject_type")
  subjectId   String          @map("subject_id")
  authorId    String          @map("author_id")

  /// Plain text, ≤ 4000. Never rendered as HTML: this is evidence, not content, and transforming
  /// it would alter evidence.
  body     String  @map("body")
  isPinned Boolean @default(false) @map("is_pinned")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@index([subjectType, subjectId, createdAt])
  @@index([authorId])
  @@map("internal_notes")
}

/// A CSV a member of staff asked for (§5.26).
///
/// The row is the receipt, which is why it outlives the file by a year. An export is the one
/// action in the portal that takes member data out of it — past the masking, past the audit of
/// who read what, into a spreadsheet on somebody's laptop — so the record of who asked for which
/// columns over which filters is the only thing that makes it accountable afterwards.
///
/// `params` holds the filters and the column list as sent, so the file can be explained later
/// without reconstructing what the portal's filter bar looked like that afternoon — and so a
/// retry produces the same file. That includes the free-text search, which is why it is stored
/// here and **redacted in the audit entry** (S14.3): the job cannot be run without the term, and
/// the trail is read by far more people, far more often, than this column is. Nothing serves
/// `params` back over the API: `ExportView` carries the columns and not the filters.
model AdminExport {
  id String @id @default(uuid())

  kind AdminExportKind @map("kind")

  /// No foreign key, for the reason the audit log has none: the receipt must survive the staff
  /// account being removed, and a cascade would delete the evidence with the person.
  requestedById String @map("requested_by_id")

  /// `{ filters, columns }`. Capped at 4 KB by the service before it is written.
  params Json @map("params")

  state    AdminExportState @default(QUEUED) @map("state")
  rowCount Int?             @map("row_count")

  /// Object key, signed for five minutes on download and never returned any other way.
  storageKey String? @map("storage_key")

  /// Why it failed, in a sentence a staff member can act on ("too many rows — narrow the filters").
  error String? @map("error")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  /// `completedAt` + 7 days (§12 Settings).
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz

  @@index([requestedById, createdAt])
  /// The expiry sweep's own index: it asks for READY rows past their date, hourly, and without
  /// this it reads every export ever made to find the handful that aged out.
  @@index([state, expiresAt])
  @@map("admin_exports")
}

/// One staff member's permission to read one private thread, for thirty minutes (S9.1–S9.4).
///
/// Everywhere else in the portal, a permission is a property of the person. This is a property of
/// the **occasion**: `messages:read` lets somebody list which conversations a member has, and this
/// row is what lets them read the words in one of them — tied to a case that exists, that they can
/// already see, and that involves somebody in the conversation.
///
/// The reason it works this way is that there is no honest answer to "who may read members' private
/// messages". Anybody who needs to read one needs to read it for a reason, and the reason is
/// checkable: a report case, a dispute, a Guard case, an escalation, a support thread, a queue
/// item. Free text — "investigating a complaint" — is not, which is why it is never accepted. So
/// the grant is the audit trail written *before* the act rather than after it, and a staff member
/// reading a thread with no grant is not a policy breach to discover later but a 403.
///
/// `ip` and `userAgent` are copied onto the row rather than left to the audit entry beside it.
/// A grant is the one record that answers "who read this, from where, and what for" in one line,
/// and that question is usually asked long afterwards by somebody who does not have the trail open.
///
/// No foreign key to the staff account, for the reason `AuditLog` has none: the record of who read
/// somebody's private messages must outlive the account that did it.
model ThreadAccessGrant {
  id             String @id @default(uuid())
  staffId        String @map("staff_id")
  conversationId String @map("conversation_id")

  reasonCode AdminReasonCode      @map("reason_code")
  linkedType ThreadAccessLinkType @map("linked_type")
  /// The case, dispute, escalation, support thread or queue item being worked on.
  linkedId   String               @map("linked_id")
  note       String?              @map("note")

  ip        String? @map("ip")
  userAgent String? @map("user_agent")

  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz
  /// `grantedAt` + 30 minutes (S9.2). Not extendable: a second half-hour is a second grant, with
  /// its own reason, which is the point.
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  /// What the grant was actually used for, as it is used. A grant taken and never used is a
  /// different fact from one used to read four pages, and only one of them is a read.
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz
  useCount   Int       @default(0) @map("use_count")

  @@index([staffId, conversationId, expiresAt])
  @@map("thread_access_grants")
}
