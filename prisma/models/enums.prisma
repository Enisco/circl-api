/**
 * The prefix a key is minted under (spec 0.11.1).
 *
 * One prefix per purpose so a key is attributable without a database lookup and
 * a prefix can be lifecycled on its own.
 */
enum MediaPurpose {
  AVATAR
  COMMUNITY
  PROFESSIONAL
  COMMERCE
  MESSAGE
  VERIFICATION
  DISPUTE
}

/**
 * Set by the S3 event handler (0.11.4). Bytes never pass through the API, so
 * there is no moment in a request where the server can inspect them: everything
 * derived hangs off the object-created notification instead.
 */
enum MediaScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

