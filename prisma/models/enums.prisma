enum ModerationDecision {
  APPROVE
  REJECT
  REMOVE_CONTENT
  WARN_AUTHOR
  SUSPEND_AUTHOR
  NO_ACTION
  /// Publish a LIMITED item: the reach was the only thing held back, so there is nothing to
  /// approve, only to restore (§5.9).
  RESTORE_REACH
  /// Remove, and tell the author why, with a strike (§5.10). Two effects named as one decision,
  /// because a reviewer picks an outcome rather than assembling one.
  REMOVE_AND_WARN
  REMOVE_AND_SUSPEND
  /// Not a moderation outcome at all: the case belongs to safeguarding, and Guard answers it.
  ESCALATE_GUARD
  /// Staff hiding and unhiding content from the content page (§5.7), as distinct from removing
  /// it: the row stays, its visibility changes.
  HIDE_CONTENT
