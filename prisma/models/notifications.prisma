// ═══════════════════════════════════════════════════════════════════════════════ Section 6.1 — Notifications
//
// The in-app list, which is a different thing from the message push in 5.6: it includes events that never produce a push, and it survives a push being dismissed.

model Notification {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  kind NotificationKind @map("kind")

  /// Already worded by the server.
  title String  @map("title")
  body  String? @map("body")

  /// Server-owned, so a new kind is tappable without an app release (5.3.1).
  route String? @map("route")

  /// The person who caused it. Null for ANNOUNCEMENT and VERIFICATION.
  actorId String? @map("actor_id")
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  /// Which preference category silences this, so a member's matrix is honoured without the sender having to know the mapping.
  categoryCode String @map("category_code")

  isRead Boolean   @default(false) @map("is_read")
  readAt DateTime? @map("read_at") @db.Timestamptz

  metadata Json? @map("metadata")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // The list is always "this member, newest first", and the badge is always "this member, unread".
  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@map("notifications")
}

/**
 * The preference matrix (6.1.3): one row per category, two channels.
 * Rows are held per member rather than as booleans on the profile, because a
 * ninth category must not need a migration, and because `label` and `isLocked`
 * come from the taxonomy so wording and ordering change without an app release
 * (D38).
 */
model NotificationPreference {
  userId       String @map("user_id")
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryCode String @map("category_code")

  push  Boolean @default(true) @map("push")
  email Boolean @default(false) @map("email")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@id([userId, categoryCode])
  @@index([userId])
  @@map("notification_preferences")
}

/**
 * Crisis and advice lines (6.3.3).
 * Served from the API rather than shipped in the binary so a number that changes
 * is fixed the same day. The client keeps its own hardcoded list as the offline
 * fallback, because a crisis line that fails to load is the worst possible time
 * to have nothing.
 */
model SupportResource {
  id          String  @id @default(uuid())
  countryCode String  @default("GB") @map("country_code")
  name        String  @map("name")
  phone       String? @map("phone")
  /// What this line is for, in the member's words. The app renders it under the name.
  description String? @map("description")
  url         String? @map("url")
  hours       String? @map("hours")

  /// Crisis rows are listed first, above an "Other places that can help" heading that holds the rest.
  isCrisis Boolean @default(false) @map("is_crisis")
  sort     Int     @default(0) @map("sort")
  isActive Boolean @default(true) @map("is_active")

  /// The date the list was last verified, rendered under it as "last checked".
  lastCheckedAt DateTime @default(now()) @map("last_checked_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([countryCode, name])
  @@index([countryCode, isActive, isCrisis, sort])
  @@map("support_resources")
}

/// §5.18: one message from Circl to many members at once.
///
/// The row is the record of a decision as much as a message. An announcement reaches thousands of
/// people's phones in Circl's name, and the thing a staff member needs to be able to answer
/// afterwards is "who did this go to, who sent it, and when" — which is why `audience` is a
/// **snapshot** of the filter rather than a live query, and why `audienceCount` is frozen at send
/// time. A filter re-run a month later describes a different population, and the question was
/// never "who matches this now".
model Announcement {
  id String @id @default(uuid())

  /// ≤ 80. The push title and the in-app row's heading.
  title String  @map("title")
  /// ≤ 500 when PUSH is selected, ≤ 5000 otherwise — a push is truncated by the OS, and a body
  /// nobody can read in the only place it appears is not a message.
  body  String  @map("body")
  /// An allowlisted app route, so a deep link cannot be an arbitrary URL (§3.16).
  route String? @map("route")

  channels AnnouncementChannel[] @map("channels")

  /// The member filter and section flags **as sent**. A snapshot, not a live query: re-running the
  /// filter later answers a different question from the one the sender asked.
  audience      Json @map("audience")
  /// Resolved at send time and frozen. Null until then.
  audienceCount Int? @map("audience_count")

  state AnnouncementState @default(DRAFT) @map("state")

  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz
  startedAt   DateTime? @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz

  /// Why a FAILED one failed, in a sentence a staff member can act on.
  failureReason String? @map("failure_reason")

  /// No foreign keys, like every other staff reference in the admin surface: the record of who
  /// sent a message to the whole platform outlives the account that sent it.
  createdById String  @map("created_by_id")
  sentById    String? @map("sent_by_id")

  /// Cached counters per channel, recomputed by the worker as batches land. The delivery rows are
  /// the truth; this is so the stats panel is one read rather than a count over hundreds of
  /// thousands of rows.
  stats Json? @map("stats")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  deliveries AnnouncementDelivery[]

  /// The scheduler's own query: what is due to go out.
  @@index([state, scheduledAt])
  @@map("announcements")
}

/// One recipient, one channel, one outcome (§5.18).
///
/// Written before the attempt rather than after it, so a fan-out that dies halfway can be resumed
/// without sending anybody twice — the primary key is the idempotency.
model AnnouncementDelivery {
  announcementId String       @map("announcement_id")
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  /// No relation to `User`: a member who deletes their account should not take the record of what
  /// the platform sent them with it, and a cascade here would do exactly that.
  userId String @map("user_id")

  channel AnnouncementChannel @map("channel")
  status  DeliveryStatus      @default(PENDING) @map("status")

  /// The `Notification` row, for IN_APP. It is what carries "opened".
  notificationId String? @map("notification_id")
  error          String? @map("error")

  sentAt   DateTime? @map("sent_at") @db.Timestamptz
  openedAt DateTime? @map("opened_at") @db.Timestamptz

  @@id([announcementId, userId, channel])
  @@index([announcementId, status])
  @@map("announcement_deliveries")
}
