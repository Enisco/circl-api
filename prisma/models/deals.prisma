// ═══════════════════════════════════════════════════════════════════════════════ Deals
//
// A short list of steps two people tick off inside one conversation, with the amount recorded when
// it is paid. Circl holds no money and cannot verify a payment: the value is that neither party can
// revise the record alone once the other has confirmed their half of it.

model Deal {
  id String @id @default(uuid())

  // A thread runs as many agreements as the two of them need. It held one, so a second quote either
  // overwrote the first or forced a new thread that lost the conversation the first was settled in.
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// Follows the thread's context: goods on one track, work on the other.
  track DealTrack @map("track")

  payerId String @map("payer_id")
  payer   User   @relation("DealPayer", fields: [payerId], references: [id], onDelete: Cascade)

  providerId String @map("provider_id")
  provider   User   @relation("DealProvider", fields: [providerId], references: [id], onDelete: Cascade)

  /// Fixed for the life of the deal: it decides who is allowed to accept it (3.3).
  proposedByRole DealRole @map("proposed_by_role")

  // ── Terms. The spine is computed from these rather than stored, so it cannot drift from them.
  amount        Int        @map("amount") // pence
  currency      String     @default("GBP") @map("currency")
  timing        DealTiming @map("timing")
  depositAmount Int?       @map("deposit_amount") // pence, and always less than the total (3.6)
  collects      Boolean    @default(false) @map("collects")
  summary       String?    @map("summary")

  /// Nothing but AGREED may be marked until this is true (3.3).
  isAgreedByBoth Boolean @default(false) @map("is_agreed_by_both")

  /// Withdrawn before anybody agreed to it. The row stays: what the two of them discussed is part
  /// of the record, and the app shows it greyed rather than pretending it never happened. An agreed
  /// deal is never withdrawn — a disagreement after agreement is what `problem` is for.
  isCancelled Boolean   @default(false) @map("is_cancelled")
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz

  /// A flag and a notification. It reverses nothing and decides nothing (7).
  hasProblem  Boolean   @default(false) @map("has_problem")
  problemNote String?   @map("problem_note")
  problemAt   DateTime? @map("problem_at") @db.Timestamptz

  /// Who raised it. The flag recorded that somebody had a problem and not which of the two it
  /// was, so §5.17's staff side could not answer the right person — and "we have looked into your
  /// deal" sent to the member who did not complain is worse than saying nothing.
  problemFlaggedById String? @map("problem_flagged_by_id")

  /// The staff side of that flag (§5.17). `hasProblem` is the member raising a hand and stays true
  /// forever — what happened to the deal is part of its record. This is whether anybody is still
  /// working on it, which is what a queue needs and `hasProblem` cannot answer.
  problemState          DealProblemState? @map("problem_state")
  problemResolvedAt     DateTime?         @map("problem_resolved_at") @db.Timestamptz
  problemResolvedById   String?           @map("problem_resolved_by_id")
  /// Shown to the member who flagged it, in their support thread.
  problemResolutionNote String?           @map("problem_resolution_note")

  steps DealStep[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // The thread's own order is the one the app trusts, and it reads every agreement in a thread.
  @@index([conversationId, createdAt])
  @@index([payerId])
  @@index([providerId])
  /// The §5.17 problem queue: flagged deals nobody has settled yet, newest first. Partial would be
  /// better still and Prisma cannot express one, so `problemState` is null for every deal that was
  /// never flagged and the index is only as big as the flags.
  @@index([problemState, problemAt])
  @@map("deals")
}

model DealStep {
  id String @id @default(uuid())

  dealId String @map("deal_id")
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  stage  DealStage @map("stage")
  byRole DealRole  @map("by_role")

  /// Carried by DEPOSIT_PAID and PAID, and immutable once the matching confirmation lands (3.4).
  amount   Int?    @map("amount")
  currency String? @map("currency")

  reachedAt DateTime @default(now()) @map("reached_at") @db.Timestamptz

  // A stage happens once. A second PAID is a 400, not a silent overwrite (3.2).
  @@unique([dealId, stage])
  @@index([dealId, reachedAt])
  @@map("deal_steps")
}
