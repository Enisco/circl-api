// ═══════════════════════════════════════════════════════════════════════════════ Section 5 — Messaging (the connective layer of Circl Social)
//
// One conversation table, five contexts.
//
// 1.
//
// D29: participants are many-to-many.

model Conversation {
  id   String     @id @default(uuid())
  kind ThreadKind @map("kind")

  contextType ThreadContextType? @map("context_type")
  contextId   String?            @map("context_id")

  // Display only.
  contextSnapshot Json? @map("context_snapshot")

  // The sorted participant pair, joined.
  participantKey String @map("participant_key")

  isPinned      Boolean   @default(false) @map("is_pinned")
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz
  messageCount  Int       @default(0) @map("message_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  group              Group?
  participants       ConversationParticipant[]
  messages           Message[]
  bookings           Booking[]
  enquiries          Enquiry[]
  disputes           Dispute[]
  guardThread        GuardThread?
  supportThread      SupportThread?
  managedRequests    ManagedRequest[]
  connectionRequests ConnectionRequest[]
  reviews            Review[]
  // As many agreements as the two of them need, not one (see deals.prisma).
  deals              Deal[]

  @@unique([participantKey, contextType, contextId])
  @@index([kind, lastMessageAt])
  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  role ParticipantRole @default(MEMBER) @map("role")

  // Held per participant, not derived at read time.
  unreadCount       Int     @default(0) @map("unread_count")
  lastReadMessageId String? @map("last_read_message_id")

  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz
  mutedUntil     DateTime? @map("muted_until") @db.Timestamptz
  isMuted        Boolean   @default(false) @map("is_muted")
  isArchived     Boolean   @default(false) @map("is_archived")
  hasSentMessage Boolean   @default(false) @map("has_sent_message")

  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz
  leftAt   DateTime? @map("left_at") @db.Timestamptz

  @@id([conversationId, userId])
  @@index([userId, isArchived])
  @@index([userId, unreadCount])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String? @map("sender_id") // null for a SYSTEM message
  sender   User?   @relation(fields: [senderId], references: [id], onDelete: SetNull)

  kind       MessageKind        @default(TEXT) @map("kind")
  body       String?            @map("body")
  systemType SystemMessageType? @map("system_type")
  systemData Json?              @map("system_data")

  // The client-generated id used for optimistic rendering, echoed in the acknowledgement so the pending bubble is replaced rather than duplicated.
  clientId String @map("client_id")

  /// Swipe to reply. The id rather than a copy of the quoted text: a stored copy would outlive the
  /// withdrawal of what it quotes, and "Message deleted" is the whole point of a tombstone. The
  /// quote is resolved on read, so a deleted original quotes as deleted everywhere at once.
  replyToMessageId String?   @map("reply_to_message_id")
  replyTo          Message?  @relation("MessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[] @relation("MessageReply")

  /// `[{ userId, offset, length }]`. Offsets are UTF-16 code units into `body`, which is what the
  /// client measures in, and are stored as sent rather than recomputed from the text.
  mentions Json? @map("mentions")

  /// Where this message came from, when that is not what the thread is about.
  ///
  /// A Connect conversation is between two people, and the profile one of them wrote from is a
  /// label on the message rather than the subject of the thread: a long conversation may carry
  /// several, and none of them splits it. Keying the thread on the profile instead is what gave
  /// two people one conversation per profile, with the reply stranded in whichever was first.
  ///
  /// Stored as sent and echoed back, with no lookup: it is what the sender's screen was showing,
  /// not an authorisation, and a profile deleted afterwards must not make the message unreadable.
  tagKind ThreadContextType? @map("tag_kind")
  tagId   String?            @map("tag_id")

  /// Said by somebody else first. Without it a forward reads as the sender's own words, which is
  /// how a rumour gets attributed to whoever passed it on.
  isForwarded Boolean @default(false) @map("is_forwarded")

  status MessageStatus @default(SENT) @map("status")

  // D26: the server stamps sentAt. Never the sending device's clock.
  sentAt    DateTime  @default(now()) @map("sent_at") @db.Timestamptz
  // D27: nullable and unused at launch, so adding editing later is not a migration.
  editedAt  DateTime? @map("edited_at") @db.Timestamptz
  // A deleted message is a tombstone, not a gap: removing the row renumbers the thread under a reader who is scrolled into it (5.3.3).
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  attachments MessageAttachment[]
  receipts    MessageReceipt[]
  reactions   MessageReaction[]

  @@unique([conversationId, clientId])
  @@index([conversationId, sentAt])
  @@index([senderId])
  @@map("messages")
}

/// One per member per message: a different emoji replaces the old one, which is why the write is a
/// PUT. The emoji is stored as the client sent it — skin tone, ZWJ and all, because `👍🏾` is not `👍`.
model MessageReaction {
  messageId String  @map("message_id")
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  emoji String @map("emoji")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([messageId, userId])
  @@index([messageId, emoji])
  @@map("message_reactions")
}

model MessageAttachment {
  id        String  @id @default(uuid())
  messageId String  @map("message_id")
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mediaId   String  @map("media_id")
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  position  Int     @default(0) @map("position")

  @@unique([messageId, mediaId])
  @@index([messageId])
  @@map("message_attachments")
}

// The server is the only writer of message status, which is why two devices on one account cannot disagree about whether something was read (5.2.4).
model MessageReceipt {
  messageId String  @map("message_id")
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz
  readAt      DateTime? @map("read_at") @db.Timestamptz

  @@id([messageId, userId])
  @@index([userId])
  @@map("message_receipts")
}

/// §4.8. The staff side of a support conversation.
///
/// A 1:1 side table rather than columns on `Conversation`, because every one of these fields is
/// about staff work — who it is assigned to, when it was answered, whether it is still waiting —
/// and `Conversation` is the member's row. Seven nullable columns on every group chat and every
/// Connect thread to serve one kind of conversation is the shape that makes a table hard to read.
model SupportThread {
  conversationId String       @id @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// The member the thread is with. A support conversation has exactly one.
  memberId String @map("member_id")
  member   User   @relation("SupportThreadMember", fields: [memberId], references: [id], onDelete: Cascade)

  type  SupportThreadType  @map("type")
  state SupportThreadState @default(NEW) @map("state")

  assignedToId String?   @map("assigned_to_id")
  assignedAt   DateTime? @map("assigned_at") @db.Timestamptz

  /// The SLA clock, and the four timestamps the inbox sorts and filters on.
  ///
  /// `firstResponseAt` is the first **staff** message after the first member message, so a thread
  /// Circl opened and the member has not replied to has no response time rather than a negative
  /// one. System messages are not responses (§7.6).
  firstMemberMessageAt DateTime? @map("first_member_message_at") @db.Timestamptz
  firstResponseAt      DateTime? @map("first_response_at") @db.Timestamptz
  lastMemberMessageAt  DateTime? @map("last_member_message_at") @db.Timestamptz
  lastStaffMessageAt   DateTime? @map("last_staff_message_at") @db.Timestamptz

  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz
  /// How many times a member came back after it was resolved. A thread reopened four times is a
  /// problem that was never actually fixed, which is the one thing a count can say and a state
  /// cannot.
  reopenCount Int       @default(0) @map("reopen_count")

  /// §7.6's "how long has this person been waiting", maintained on write.
  ///
  /// Derived data in a column, deliberately and narrowly: it is the inbox's sort key and the
  /// definition is a comparison between two other columns (`lastMemberMessageAt` newer than
  /// `lastStaffMessageAt`, in an answerable state), which Postgres can express and Prisma's
  /// `orderBy` cannot. Sorting on `lastMemberMessageAt` instead would let a thread waiting on the
  /// *member* jump ahead of a member waiting on us.
  ///
  /// Every read recomputes it from the timestamps via `waitingSince()` rather than trusting it, so
  /// a column that drifts changes the order of a page and never the answer on it.
  waitingSince DateTime? @map("waiting_since") @db.Timestamptz

  /// Member messages nobody on staff has opened yet.
  ///
  /// On the thread rather than per staff member, which is the opposite of how the member side
  /// counts unread. A support inbox is one shared queue: "two of us have read it and four have
  /// not" is not a fact anybody acts on, and B17 is going to stop adding every staff account as a
  /// participant of every support thread — at which point a per-person count would have nowhere
  /// left to live.
  unreadForStaff Int @default(0) @map("unread_for_staff")

  tags String[] @map("tags")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([state, assignedToId, lastMemberMessageAt])
  @@index([memberId])
  /// The inbox's "longest wait first", which is the view somebody works down.
  @@index([state, waitingSince])
  @@map("support_threads")
}

/// §5.15. A reply somebody writes once and the whole team sends.
model CannedReply {
  id    String @id @default(uuid())
  title String @map("title")
  body  String @map("body")

  /// Deactivated rather than deleted, so a reply that was sent a thousand times keeps its record
  /// and stops being offered.
  isActive Boolean @default(true) @map("is_active")

  createdById String @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([isActive, title])
  @@map("canned_replies")
}
