// ═══════════════════════════════════════════════════════════════════════════════ Circl Intelligence
//
// "One algorithm, fed by every action taken on the platform — every search, post, click, engagement, and transaction.
//
// Guided Creation — suggests related items from real, local demand Auto-Guides — drafts a guide when three or more members ask the same thing Smart Match — scores briefs against professionals (see BriefMatch) Public Metrics — the Pulse dashboards in every section
//
// All four are computed from the two tables below plus ordinary SQL.

// The single behavioural stream. One row per action, narrow and append-only.
model ActivityEvent {
  id     String  @id @default(uuid())
  userId String? @map("user_id") // null for a signed-out read
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  verb    ActivityVerb    @map("verb")
  subject ActivitySubject @map("subject")

  subjectId  String?      @map("subject_id")
  cityId     String?      @map("city_id")
  // The category / topic / profession code of the thing acted on, so demand can be grouped without joining back to five different tables.
  code       String?      @map("code")
  term       String?      @map("term") // for SEARCH
  /// Which search box it was typed into. Only set for SEARCH, and a column rather than metadata
  /// because every published metric groups by it (6.3).
  scope      SearchScope? @map("scope")
  /// Whether the search found anything. Recorded here because it cannot be recomputed later: the
  /// catalogue has changed by the time the job runs, and "searched and found nothing" is the
  /// metric a prospective seller or guide writer most wants.
  hadResults Boolean?     @map("had_results")
  weight     Int          @default(1) @map("weight")
  metadata   Json?        @map("metadata")

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  @@index([cityId, subject, occurredAt])
  @@index([userId, occurredAt])
  @@index([subject, code, occurredAt])
  @@index([verb, term, occurredAt])
  @@index([subject, scope, occurredAt])
  @@map("activity_events")
}

/**
 * What a typed fragment actually meant, resolved once and remembered.
 * Somebody searching for olive oil types "o", "ol", "oliv" and then "olive oil" — four rows in the
 * stream and one thing wanted. Publishing the fragments would be publishing noise, so each raw
 * term is resolved to a canonical one before anything is shown.
 * Resolved against our own data rather than by a model: the taxonomy labels and the trigram
 * indexes on item names, guide titles and profession titles already hold the words members are
 * reaching for. This table is the dictionary, so a term is only ever worked out once — and it is
 * where a model's answer would go if one is ever added, with nothing else changing.
 */
model SearchTermCanonical {
  /// Lowercased, trimmed, punctuation stripped. The key the stream is grouped by.
  normalised String      @map("normalised")
  scope      SearchScope @map("scope")

  /// What to show, and what tapping it searches for.
  canonical    String           @map("canonical")
  source       SearchTermSource @map("source")
  /// The category it resolved to, where it did, so a tap can filter rather than guess.
  categoryCode String?          @map("category_code")

  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz
  resolvedAt  DateTime @default(now()) @map("resolved_at") @db.Timestamptz

  @@id([normalised, scope])
  @@index([scope, source])
  @@map("search_term_canonical")
}

// "Show me less like this" from a feed card's overflow menu (1.1).
model FeedFeedback {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemType FeedItemType        @map("item_type")
  itemId   String              @map("item_id")
  reason   FeedFeedbackReason? @map("reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, itemType, itemId])
  @@index([userId, createdAt])
  @@map("feed_feedback")
}

// A maintained rollup of demand per (city, surface, code) so Guided Creation and the demand-hint card are a single indexed read rather than an aggregate over the whole event stream on every composer open.
model DemandSignal {
  id      String            @id @default(uuid())
  cityId  String?           @map("city_id")
  surface SuggestionSurface @map("surface")

  code String? @map("code")
  term String? @map("term")

  label       String @map("label")
  searchCount Int    @default(0) @map("search_count")
  actionCount Int    @default(0) @map("action_count")
  supplyCount Int    @default(0) @map("supply_count")
  // demand relative to supply — what makes a suggestion worth showing
  score       Float  @default(0) @map("score")

  windowStart DateTime @map("window_start") @db.Timestamptz
  windowEnd   DateTime @map("window_end") @db.Timestamptz
  computedAt  DateTime @default(now()) @map("computed_at") @db.Timestamptz

  @@unique([cityId, surface, code, term])
  @@index([cityId, surface, score])
  @@map("demand_signals")
}

// Auto-Guides: when three or more members ask the same question, the system drafts a Guide and cites the most helpful answers.
model QuestionCluster {
  id           String  @id @default(uuid())
  categoryCode String  @map("category_code")
  cityId       String? @map("city_id")

  // The normalised phrase the cluster formed around, and its member requests.
  signature  String @map("signature")
  label      String @map("label")
  requestIds Json   @map("request_ids")
  askCount   Int    @default(0) @map("ask_count")

  // Set once a guide has been drafted from this cluster, so it is not redrafted every time the job runs.
  draftedGuideId String? @map("drafted_guide_id")

  firstAskedAt DateTime @map("first_asked_at") @db.Timestamptz
  lastAskedAt  DateTime @map("last_asked_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([categoryCode, cityId, signature])
  @@index([askCount, lastAskedAt])
  @@map("question_clusters")
}

// Public Metrics — one engine, four views (Community, Professionals, Connect, Commerce).
//
// D19 applies to every bucket here: anything under 20 people is suppressed rather than rounded, and no view exposes an individual.
model MetricSnapshot {
  id      String  @id @default(uuid())
  section String  @map("section") // COMMUNITY | PROFESSIONALS | CONNECT | COMMERCE
  metric  String  @map("metric")
  cityId  String? @map("city_id")
  period  String  @map("period") // WEEK | MONTH | ALL_TIME

  items Json @map("items") // [{ code|term, label, value, ... }]

  windowStart DateTime @map("window_start") @db.Timestamptz
  windowEnd   DateTime @map("window_end") @db.Timestamptz
  computedAt  DateTime @default(now()) @map("computed_at") @db.Timestamptz

  @@unique([section, metric, cityId, period])
  @@index([section, cityId])
  @@map("metric_snapshots")
}
