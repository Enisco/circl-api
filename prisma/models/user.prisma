model User {
  id              String            @id @default(uuid())
  firstName       String            @map("first_name")
  lastName        String            @map("last_name")
  username        String?           @unique @map("username")
  profileImageUrl String?           @map("profile_image_url")
  isStaff         Boolean           @default(false) @map("is_staff")
  email           String            @unique @map("email")
  status          UserAccountStatus @default(PENDING) @map("status")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz

  // ── Account deletion (spec 0.15) ──────────────────────────────────────────
  // Anonymised is not a status flag on a row that still holds the data: the
  // personal data is destroyed in the same transaction. What survives is this
  // marker and a one-way hash of the email, so the same address cannot silently
  // re-register onto the old record and `410` can be returned rather than a
  // confusing `404`.
  isAnonymised    Boolean   @default(false) @map("is_anonymised")
  anonymisedAt    DateTime? @map("anonymised_at") @db.Timestamptz
  deletedEmailHash String?  @unique @map("deleted_email_hash")

  userAuth          UserAuth?
  profile           UserProfile?
  adminProfile      AdminProfile?
  sessions          UserSession[]
  userRole          UserRole?
  socialAuths       UserSocialAuth[]
  notificationPrefs UserNotificationPrefs?

  // ── Community ─────────────────────────────────────────────────────────────
  requests        CommunityRequest[] @relation("RequestAuthor")
  requestResponses RequestResponse[] @relation("ResponseAuthor")
  creditedOn      RequestHelper[]
  offers          CommunityOffer[]   @relation("OfferAuthor")
  updates         CommunityUpdate[]  @relation("UpdateAuthor")
  updateReplies   UpdateReply[]
  updateReactions UpdateReaction[]
  updateTags      UpdateTag[]
  guides          Guide[]            @relation("GuideAuthor")
  guideReactions  GuideReaction[]
  guideBookmarks  GuideBookmark[]
  guideFeedback   GuideFeedback[]
  guideProgress   GuideProgress[]
  guideDeflections GuideDeflection[]
  groupsCreated   Group[]            @relation("GroupCreator")
  groupMemberships GroupMembership[]
  groupPosts      GroupPost[]
  groupPostReplies GroupPostReply[]

  // ── Moderation & Guard ────────────────────────────────────────────────────
  reportsFiled      Report[]              @relation("ReportFiler")
  reportsAbout      Report[]              @relation("ReportSubject")
  blocksMade        Block[]               @relation("Blocker")
  blocksReceived    Block[]               @relation("Blocked")
  moderationActions ModerationAction[]    @relation("ModerationActor")
  queueSubjectOf    ModerationQueueItem[] @relation("QueueSubject")
  queueAssignedTo   ModerationQueueItem[] @relation("QueueAssignee")
  guardThreads      GuardThread[]
  guardAssignedTo   GuardThread[]         @relation("GuardAssignee")

  // ── Trust ─────────────────────────────────────────────────────────────────
  trustChecks       TrustCheck[]
  reviewsReceived   Review[]           @relation("ReviewSubject")
  reviewsWritten    Review[]           @relation("ReviewAuthor")
  reputationSummary ReputationSummary?

  // ── Professionals ─────────────────────────────────────────────────────────
  professionalListing ProfessionalListing?
  briefs              ManagedBrief[]
  bookingsAsClient    Booking[]         @relation("BookingClient")
  bookingsAsPro       Booking[]         @relation("BookingProfessional")
  disputesRaised      Dispute[]
  disputeEvidence     DisputeEvidence[]
  managedRequests     ManagedRequest[]

  // ── Connect ───────────────────────────────────────────────────────────────
  connectProfile ConnectProfile?

  // ── Commerce ──────────────────────────────────────────────────────────────
  store             Store?
  enquiriesAsBuyer  Enquiry[]     @relation("EnquiryBuyer")
  enquiriesAsSeller Enquiry[]     @relation("EnquirySeller")
  aiDrafts          AiItemDraft[]
  aiDraftJobs       AiDraftJob[]

  // ── Messaging ─────────────────────────────────────────────────────────────
  conversations   ConversationParticipant[]
  messages        Message[]
  messageReceipts MessageReceipt[]

  // ── Media & Intelligence ──────────────────────────────────────────────────
  media          Media[]
  activityEvents ActivityEvent[]
  feedFeedback   FeedFeedback[]

  @@index([email])
  @@index([username])
  @@map("users")
}

// Social login providers (Apple Sign-In, Google Sign-In)
model UserSocialAuth {
  id         String         @id @default(uuid())
  userId     String         @map("user_id")
  provider   SocialProvider @map("provider")
  providerId String         @map("provider_id") // Subject claim from the identity token
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("user_social_auth")
}

model UserAuth {
  id                  String    @id @default(uuid())
  userId              String    @unique @map("user_id")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  password            String?   @map("password")
  isBlocked           Boolean   @default(false) @map("is_blocked")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lastFailedLoginAt   DateTime? @map("last_failed_login_at") @db.Timestamptz
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz
  emailVerifiedAt     DateTime? @map("email_verified_at") @db.Timestamptz
  passwordUpdatedAt   DateTime? @map("password_updated_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId])
  @@map("user_auth")
}

model AdminProfile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar    String?  @map("avatar")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("admin_profile")
}

model UserProfile {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Identity ──────────────────────────────────────────────────────────────
  gender          Gender? @map("gender")
  cityId          String? @map("city_id")
  city            City?   @relation(fields: [cityId], references: [id])
  countryOfOrigin String? @map("country_of_origin")

  // D10 / D15 / D16. These four are the continuity contract made physical: they
  // live on the user because Connect, Professionals and Commerce all read them,
  // and a second copy is guaranteed to disagree with the first.
  //
  // dateOfBirth is one field, held once. Connect derives an age from it and never
  // stores a number — a number cannot be re-validated later, and someone who
  // typed 18 last year is still 18 forever. Null is a valid state: only surfaces
  // that need an age ask for one (D16). Changing it once set is a support action,
  // because it is an age gate.
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  dateOfBirthSetAt  DateTime? @map("date_of_birth_set_at") @db.Timestamptz

  // Collected once in onboarding, prefilled everywhere after. Connect writes
  // through to these rather than keeping its own copy (3.1.3).
  interests    Json?   @map("interests") // up to 8 INTEREST codes
  languages    Json?   @map("languages") // up to 6 LANGUAGE codes
  heritageTag  String? @map("heritage_tag") // one HERITAGE_TAG code, shared with Commerce (3.1.4)
  journeyStage String? @map("journey_stage") // one JOURNEY_STAGE code

  // ── Contact ───────────────────────────────────────────────────────────────
  phoneNumberDiallingCode String? @map("phone_number_dialling_code")
  phoneNumber             String? @map("phone_number")

  // ── Community presence ────────────────────────────────────────────────────
  bio         String? @map("bio")
  canHelpWith String? @map("can_help_with")
  openInbox   Boolean @default(true) @map("open_inbox")

  // ── Onboarding ────────────────────────────────────────────────────────────
  onboardingStep      Int     @default(0) @map("onboarding_step")
  onboardingCompleted Boolean @default(false) @map("onboarding_completed")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([cityId])
  @@map("user_profile")
}

model UserSession {
  id                String    @id() @default(uuid())
  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent         String    @map("user_agent")
  deviceType        String    @map("device_type")
  browserName       String    @map("browser_name")
  operatingSystem   String    @map("operating_system")
  ipAddress         String    @map("ip_address")
  isActive          Boolean   @default(false) @map("is_active")
  deviceFingerprint String    @map("device_fingerprint")
  refreshToken      String?   @map("refresh_token")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastActiveAt      DateTime  @default(now()) @map("last_active_at") @db.Timestamptz
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz

  @@unique([userId, deviceFingerprint])
  @@index([userId])
  @@index([userId, isActive])
  @@map("user_sessions")
}

model UserNotificationPrefs {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  devicePushToken String?  @map("device_push_token")

  // ── In-app notification toggles (PRF-03) ─────────────────────────────────
  newOffersOnMyRequests Boolean @default(true) @map("new_offers_on_my_requests")
  newMessages           Boolean @default(true) @map("new_messages")
  groupActivity         Boolean @default(true) @map("group_activity")
  connectionRequests    Boolean @default(true) @map("connection_requests")
  platformUpdates       Boolean @default(true) @map("platform_updates")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_notification_prefs")
}
