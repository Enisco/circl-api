// ═══════════════════════════════════════════════════════════════════════════════ Section 2 — Professionals
//
// Circl does not handle money (2.0.1).

model ProfessionalListing {
  id     String @id @default(uuid())
  userId String @unique @map("user_id") // one listing per user
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  professionTitle String          @map("profession_title")
  experienceLevel ExperienceLevel @map("experience_level")
  yearsExperience Int?            @map("years_experience")
  about           String          @map("about")

  cityId String @map("city_id")
  city   City   @relation(fields: [cityId], references: [id])

  deliveryMode DeliveryMode @default(IN_PERSON) @map("delivery_mode")
  priceFrom    Int?         @map("price_from") // pence
  priceBasis   PriceBasis   @default(NEGOTIABLE) @map("price_basis")
  currency     String       @default("GBP") @map("currency")

  /// The listing's own two pictures, object keys signed on read like every other image (0.11.3).
  /// Both optional: a listing with no photo falls back to the member's account avatar, which is
  /// what every listing showed before these existed, and a listing with no cover keeps the
  /// gradient. A personal photo is not always the right professional one, and a listing that is a
  /// small firm wants its logo, which an account photo can never be.
  photoKey String? @map("photo_key")
  coverKey String? @map("cover_key")

  isAcceptingWork    Boolean                   @default(true) @map("is_accepting_work")
  freeConsultation   Boolean                   @default(false) @map("free_consultation")
  verificationStatus ListingVerificationStatus @default(UNVERIFIED) @map("verification_status")

  // ── Approval for gated professions (§2.9) ─────────────────────────────────
  /// Where this listing is in the approval workflow. Whether the public can *see* it is
  /// `visibilityState`, which the safety pipeline mirrors — a listing can be `PENDING` and still
  /// public, which is exactly what a listing that was live before this shipped is: grandfathered,
  /// queued, and not yanked out from under somebody mid-job.
  reviewState       ListingReviewState @default(NOT_REQUIRED) @map("review_state")
  reviewSubmittedAt DateTime?          @map("review_submitted_at") @db.Timestamptz
  reviewDecidedAt   DateTime?          @map("review_decided_at") @db.Timestamptz
  reviewDecidedById String?            @map("review_decided_by_id")
  /// What the reviewer said, shown to the member verbatim on a decline so they can fix it.
  reviewNote        String?            @map("review_note")

  // D13 mitigation: with no credential checks, store what was agreed and when, so an unchecked claim is at least an unchecked claim that says so.
  consentAccepted   Boolean   @default(false) @map("consent_accepted")
  consentAcceptedAt DateTime? @map("consent_accepted_at") @db.Timestamptz
  consentVersion    String?   @map("consent_version")

  // The link back to the community offer this was promoted from (2.1.3).
  sourceOfferId String? @map("source_offer_id")

  profileViews          Int  @default(0) @map("profile_views")
  jobsCompleted         Int  @default(0) @map("jobs_completed")
  medianResponseMinutes Int? @map("median_response_minutes")

  submittedAt DateTime? @map("submitted_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  categories         ProfessionalListingCategory[]
  services           ProfessionalService[]
  bookings           Booking[]
  briefMatches       BriefMatch[]
  promotedOffer      CommunityOffer?               @relation("OfferPromotion")
  availability       ListingAvailability[]
  availabilityBlocks ListingAvailabilityBlock[]

  /// Whether the public can see this (§6.5). Mirrors `ContentSafety.visibilityState`, and this is
  /// the copy every read path filters on — one column on the table being queried, rather than a
  /// join against a polymorphic safety table on every feed page.
  visibilityState ContentVisibilityState @default(VISIBLE) @map("visibility_state")

  @@index([cityId, isAcceptingWork])
  @@index([verificationStatus])
  /// The review queue's own ordering: oldest submission first, within a state.
  @@index([reviewState, reviewSubmittedAt])
  // Trigram search (0.5). Declared so `migrate dev` stops proposing to drop it.
  @@index([professionTitle(ops: raw("gin_trgm_ops"))], type: Gin, map: "professional_listings_title_trgm_idx")
  @@map("professional_listings")
}

// 1 to 3 profession codes per listing (2.6.1).
model ProfessionalListingCategory {
  listingId String              @map("listing_id")
  listing   ProfessionalListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  code      String              @map("code") // TaxonomyKind.PROFESSION
  isPrimary Boolean             @default(false) @map("is_primary")

  @@id([listingId, code])
  @@index([code])
  @@map("professional_listing_categories")
}

model ProfessionalService {
  id        String              @id @default(uuid())
  listingId String              @map("listing_id")
  listing   ProfessionalListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  name        String     @map("name")
  description String?    @map("description")
  price       Int?       @map("price") // pence; null means "on request"
  priceBasis  PriceBasis @default(NEGOTIABLE) @map("price_basis")
  currency    String     @default("GBP") @map("currency")
  isActive    Boolean    @default(true) @map("is_active")
  sort        Int        @default(0) @map("sort")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  bookings Booking[]

  // Never hard-deleted while a booking references it, or the booking loses its own subject (2.6.3).

  /// Whether the public can see this (§6.5). Mirrors `ContentSafety.visibilityState`, and this is
  /// the copy every read path filters on — one column on the table being queried, rather than a
  /// join against a polymorphic safety table on every feed page.
  visibilityState ContentVisibilityState @default(VISIBLE) @map("visibility_state")

  @@index([listingId, isActive])
  @@map("professional_services")
}

// ─── Managed briefs and Smart Match (Circl Intelligence) ─────────────────────

model ManagedBrief {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryCode String       @map("category_code")
  description  String       @map("description")
  urgency      BriefUrgency @default(FLEXIBLE) @map("urgency")
  budget       Int?         @map("budget") // pence, display only
  currency     String       @default("GBP") @map("currency")

  cityId String? @map("city_id")
  city   City?   @relation(fields: [cityId], references: [id])

  state BriefState @default(OPEN) @map("state")

  chosenListingId String? @map("chosen_listing_id")
  bookingId       String? @map("booking_id")

  /// Who placed it, when staff did (§5.16). Null for a brief the member placed themselves, which
  /// is the difference between "Circl chose this professional" and "the member did" — and that
  /// difference is the first thing asked if the placement goes badly.
  placedById String?   @map("placed_by_id")
  placedAt   DateTime? @map("placed_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  matches  BriefMatch[]
  bookings Booking[]

  @@index([userId, state])
  @@map("managed_briefs")
}

// Scores are 0..1 with a one-word qualifier computed server-side, so the four mini-bars and their labels agree everywhere (2.8.2).
model BriefMatch {
  id      String       @id @default(uuid())
  briefId String       @map("brief_id")
  brief   ManagedBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  listingId String              @map("listing_id")
  listing   ProfessionalListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  rank          Int   @map("rank")
  totalScore    Float @map("total_score")
  ratingScore   Float @map("rating_score")
  distanceScore Float @map("distance_score")
  priceScore    Float @map("price_score")
  responseScore Float @map("response_score")
  priceForBrief Int?  @map("price_for_brief")

  // A plain sentence, or null.
  rationale String? @map("rationale")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([briefId, listingId])
  @@index([briefId, rank])
  @@map("brief_matches")
}

// ─── Bookings ────────────────────────────────────────────────────────────────

model Booking {
  id String @id @default(uuid())

  clientId String @map("client_id")
  client   User   @relation("BookingClient", fields: [clientId], references: [id], onDelete: Cascade)

  professionalId String @map("professional_id")
  professional   User   @relation("BookingProfessional", fields: [professionalId], references: [id], onDelete: Cascade)

  listingId String              @map("listing_id")
  listing   ProfessionalListing @relation(fields: [listingId], references: [id])

  serviceId String?              @map("service_id")
  service   ProfessionalService? @relation(fields: [serviceId], references: [id])

  briefId String?       @map("brief_id")
  brief   ManagedBrief? @relation(fields: [briefId], references: [id])

  // Copied from the service or the brief at creation.
  serviceName        String  @map("service_name")
  serviceDescription String? @map("service_description")
  quotedAmount       Int?    @map("quoted_amount")
  agreedAmount       Int?    @map("agreed_amount") // D12: a record, not financial data
  currency           String  @default("GBP") @map("currency")

  state JobState @default(PENDING_ACCEPTANCE) @map("state")

  preferredDate     DateTime?   @map("preferred_date") @db.Date
  preferredTimeSlot String?     @map("preferred_time_slot")
  isFlexible        Boolean     @default(false) @map("is_flexible")
  mode              BookingMode @default(ONLINE) @map("mode")
  address           String?     @map("address")
  details           String?     @map("details")

  conversationId String?       @map("conversation_id")
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  // 7 days after DELIVERED.
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz
  autoCompleteAt DateTime? @map("auto_complete_at") @db.Timestamptz
  completedAt    DateTime? @map("completed_at") @db.Timestamptz
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz
  cancelReason   String?   @map("cancel_reason")

  firstClientMessageAt DateTime? @map("first_client_message_at") @db.Timestamptz
  firstProReplyAt      DateTime? @map("first_pro_reply_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  events   BookingEvent[]
  disputes Dispute[]
  reviews  Review[]

  @@index([clientId, state, createdAt])
  @@index([professionalId, state, createdAt])
  @@index([state, autoCompleteAt])
  @@map("bookings")
}

// The timeline is data, not a client-side derivation, because each stage is timestamped and the client must not have to invent the order (2.9.1).
model BookingEvent {
  id        String  @id @default(uuid())
  bookingId String  @map("booking_id")
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  stage    JobStage @map("stage")
  actorId  String?  @map("actor_id")
  note     String?  @map("note")
  metadata Json?    @map("metadata")

  reachedAt DateTime @default(now()) @map("reached_at") @db.Timestamptz

  @@unique([bookingId, stage])
  @@index([bookingId, reachedAt])
  @@map("booking_events")
}

// ─── Disputes ────────────────────────────────────────────────────────────────

// One dispute resource, polymorphic on subject, shared by bookings and commerce enquiries (4.1.3) so "Report a problem" behaves the same wherever it is raised.
model Dispute {
  id String @id @default(uuid())

  subjectType DisputeSubjectType @map("subject_type")
  bookingId   String?            @map("booking_id")
  booking     Booking?           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  enquiryId   String?            @map("enquiry_id")
  enquiry     Enquiry?           @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  raisedById String @map("raised_by_id")
  raisedBy   User   @relation(fields: [raisedById], references: [id], onDelete: Cascade)

  reasonCode  DisputeReason @map("reason_code")
  description String        @map("description")
  state       DisputeState  @default(OPEN) @map("state")

  conversationId String?       @map("conversation_id")
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  /// Whose work this is (§5.17).
  assignedToId String?   @map("assigned_to_id")
  assignedAt   DateTime? @map("assigned_at") @db.Timestamptz

  expectedResolutionAt DateTime?       @map("expected_resolution_at") @db.Timestamptz
  resolvedAt           DateTime?       @map("resolved_at") @db.Timestamptz
  /// The finding. `resolutionNote` is what both parties read, and this is what the platform
  /// concluded — kept apart because one is prose written for two members in a disagreement and the
  /// other is the value a chart counts.
  outcome              DisputeOutcome? @map("outcome")
  resolutionNote       String?         @map("resolution_note")
  resolvedById         String?         @map("resolved_by_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  evidence DisputeEvidence[]

  @@index([state, createdAt])
  @@index([bookingId])
  @@index([enquiryId])
  @@index([assignedToId, state])
  @@map("disputes")
}

// "Both of you can add evidence" is promised on the screen, so it has to be true after submission and not only during (2.10).
model DisputeEvidence {
  id        String  @id @default(uuid())
  disputeId String  @map("dispute_id")
  dispute   Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  submittedById String @map("submitted_by_id")
  submittedBy   User   @relation(fields: [submittedById], references: [id], onDelete: Cascade)

  note      String?  @map("note")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([disputeId])
  @@map("dispute_evidence")
}

// ─── Managed requests (shared with Commerce, 4.10) ───────────────────────────

model ManagedRequest {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectType ManagedRequestSubject @map("subject_type")
  state       ManagedRequestState   @default(OPEN) @map("state")

  helpAreas Json?   @map("help_areas")
  notes     String? @map("notes")
  storeId   String? @map("store_id")
  briefId   String? @map("brief_id")

  /// Whose work this is (§5.16). No foreign key, like every other staff reference in the admin
  /// surface: the record of who handled a member's request outlives the staff account that did.
  assignedToId String?   @map("assigned_to_id")
  assignedAt   DateTime? @map("assigned_at") @db.Timestamptz

  /// Required to close (§7.7). "Closed" with no reason is a pipeline that cannot be reported on:
  /// a request that ended because we placed the member and one that ended because we could not
  /// help are the same row otherwise, and they are the two numbers this pipeline exists to produce.
  closedReason ManagedRequestClosedReason? @map("closed_reason")
  closedAt     DateTime?                   @map("closed_at") @db.Timestamptz

  conversationId String?       @map("conversation_id")
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([state, createdAt])
  @@index([userId])
  /// The pipeline's own filter: "my open requests" and "nobody's yet".
  @@index([assignedToId, state])
  @@map("managed_requests")
}

/// The working week behind the booking slot picker (G5). Without it the app offers the same six
/// days and eight times for every professional, forever.
model ListingAvailability {
  listingId String              @map("listing_id")
  listing   ProfessionalListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  day       Weekday             @map("day")

  /// Minutes from midnight, the same unit the store opening hours use.
  startMinutes Int @map("start_minutes")
  endMinutes   Int @map("end_minutes")
  /// How long one bookable slot runs for, so an hour-long consultation and a 30-minute call differ.
  slotMinutes  Int @default(60) @map("slot_minutes")

  @@id([listingId, day])
  @@map("listing_availability")
}

/// A single day the professional is not working: holiday, or a date they blocked out.
model ListingAvailabilityBlock {
  id        String              @id @default(uuid())
  listingId String              @map("listing_id")
  listing   ProfessionalListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  date   DateTime @map("date") @db.Date
  reason String?  @map("reason")

  @@unique([listingId, date])
  @@index([listingId, date])
  @@map("listing_availability_blocks")
}
