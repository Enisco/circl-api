// ═══════════════════════════════════════════════════════════════════════════════ Section 2 — Professionals
//
// Circl does not handle money (2.0.1).

model ProfessionalListing {
  id     String @id @default(uuid())
  userId String @unique @map("user_id") // one listing per user
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  professionTitle String          @map("profession_title")
  experienceLevel ExperienceLevel @map("experience_level")
  yearsExperience Int?            @map("years_experience")
  about           String          @map("about")

  cityId String @map("city_id")
  city   City   @relation(fields: [cityId], references: [id])

  deliveryMode DeliveryMode @default(IN_PERSON) @map("delivery_mode")
  priceFrom    Int?         @map("price_from") // pence
  priceBasis   PriceBasis   @default(NEGOTIABLE) @map("price_basis")
  currency     String       @default("GBP") @map("currency")

  /// The listing's own two pictures, object keys signed on read like every other image (0.11.3).
  /// Both optional: a listing with no photo falls back to the member's account avatar, which is
  /// what every listing showed before these existed, and a listing with no cover keeps the
  /// gradient. A personal photo is not always the right professional one, and a listing that is a
  /// small firm wants its logo, which an account photo can never be.
  photoKey String? @map("photo_key")
  coverKey String? @map("cover_key")

  isAcceptingWork    Boolean                   @default(true) @map("is_accepting_work")
  freeConsultation   Boolean                   @default(false) @map("free_consultation")
  verificationStatus ListingVerificationStatus @default(UNVERIFIED) @map("verification_status")

  // ── Approval for gated professions (§2.9) ─────────────────────────────────
  /// Where this listing is in the approval workflow. Whether the public can *see* it is
  /// `visibilityState`, which the safety pipeline mirrors — a listing can be `PENDING` and still
  /// public, which is exactly what a listing that was live before this shipped is: grandfathered,
  /// queued, and not yanked out from under somebody mid-job.
  reviewState       ListingReviewState @default(NOT_REQUIRED) @map("review_state")
  reviewSubmittedAt DateTime?          @map("review_submitted_at") @db.Timestamptz
  reviewDecidedAt   DateTime?          @map("review_decided_at") @db.Timestamptz
  reviewDecidedById String?            @map("review_decided_by_id")
  /// What the reviewer said, shown to the member verbatim on a decline so they can fix it.
  reviewNote        String?            @map("review_note")

  // D13 mitigation: with no credential checks, store what was agreed and when, so an unchecked claim is at least an unchecked claim that says so.
  consentAccepted   Boolean   @default(false) @map("consent_accepted")
  consentAcceptedAt DateTime? @map("consent_accepted_at") @db.Timestamptz
  consentVersion    String?   @map("consent_version")

  // The link back to the community offer this was promoted from (2.1.3).
  sourceOfferId String? @map("source_offer_id")

  profileViews          Int  @default(0) @map("profile_views")
  jobsCompleted         Int  @default(0) @map("jobs_completed")
  medianResponseMinutes Int? @map("median_response_minutes")

  submittedAt DateTime? @map("submitted_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  /**
   * Free-text skills, displayed exactly like the coded ones and **never** filterable (v2 §4.1).
   * Two fields rather than one for the same reason the product's units already split
   * (`unitCode` + `unitCustomLabel`): a coded skill can be filtered, counted and translated —
   * "fourteen people here do ILR applications" is only answerable with codes — and a custom one
   * is a member describing something the vocabulary has not caught up with yet. They are never
   * promoted into the taxonomy automatically; the admin portal surfaces the recurring ones so a
   * human can decide.
   */
  customSkills String[] @map("custom_skills")

  categories         ProfessionalListingCategory[]
  skills             ProfessionalListingSkill[]
  contactHours       ProfessionalContactHours[]
  services           ProfessionalService[]
  bookings           Booking[]
  briefMatches       BriefMatch[]
  promotedOffer      CommunityOffer?               @relation("OfferPromotion")
  availability       ListingAvailability[]
  availabilityBlocks ListingAvailabilityBlock[]

  /// Whether the public can see this (§6.5). Mirrors `ContentSafety.visibilityState`, and this is
  /// the copy every read path filters on — one column on the table being queried, rather than a
  /// join against a polymorphic safety table on every feed page.
  visibilityState ContentVisibilityState @default(VISIBLE) @map("visibility_state")

  @@index([cityId, isAcceptingWork])
  @@index([verificationStatus])
  /// The review queue's own ordering: oldest submission first, within a state.
  @@index([reviewState, reviewSubmittedAt])
  // Trigram search (0.5). Declared so `migrate dev` stops proposing to drop it.
  @@index([professionTitle(ops: raw("gin_trgm_ops"))], type: Gin, map: "professional_listings_title_trgm_idx")
  @@map("professional_listings")
}

// 1 to 3 profession codes per listing (2.6.1).
model ProfessionalListingCategory {
  listingId String              @map("listing_id")
  listing   ProfessionalListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  code      String              @map("code") // TaxonomyKind.PROFESSION
  isPrimary Boolean             @default(false) @map("is_primary")

  @@id([listingId, code])
  @@index([code])
  @@map("professional_listing_categories")
}

/// One thing a professional sells (v2 §5). A first-class object: it has its own page, its own id in
/// a URL, its own category, media, updates and milestones — and it is what members search.
model ProfessionalService {
  id        String              @id @default(uuid())
  listingId String              @map("listing_id")
  listing   ProfessionalListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  name        String     @map("name")
  /// Required on create, nullable on read: services written before v2 have none, and rendering one
  /// without a description is better than hiding somebody's live work (v2 §10).
  description String?    @map("description")
  /**
   * Pence; null means "on request".
   *
   * **The one number every surface quotes.** A card, a search row, a thread subject and a
   * notification can each render one figure and none of them can render a list, so on a
   * `PACKAGES` service this holds the **cheapest package's** price and is recomputed from the
   * packages on every write — the client's own figure is a hint, never the authority. Price
   * sorting and the `maxPricePence` filter read this column for the same reason: filtering on a
   * stale flat rate would hide a service whose cheapest package is well inside the filter.
   */
  price       Int?       @map("price")
  priceBasis  PriceBasis @default(NEGOTIABLE) @map("price_basis")
  currency    String     @default("GBP") @map("currency")
  sort        Int        @default(0) @map("sort")

  /// One number or several named packages, never both. `FLAT` for every service written before
  /// packages existed, which is why the default is correct without a backfill.
  pricingKind ServicePricingKind @default(FLAT) @map("pricing_kind")

  /**
   * What a first conversation costs, in pence, or null for "not charged for".
   *
   * **Not part of the price and not a package.** It is never folded into `price`, never becomes
   * the cheapest package, and is never what a card quotes — a buyer reading one figure for two
   * things is a buyer who has been misled. It is also kept out of every price filter and sort for
   * the same reason.
   */
  consultationFeePence Int? @map("consultation_fee_pence")

  /// The category this service is sold under — **not** necessarily one of the listing's three
  /// profile categories (v2, decision 1). Backfilled from the listing's primary category for
  /// services that predate the field.
  categoryCode    String? @map("category_code")
  /// Required when the category has active children, and the gate usually lives here rather than
  /// on the parent.
  subcategoryCode String? @map("subcategory_code")

  /**
   * What the owner decided. The rest of the status is derived (v2 §5.4).
   * `isActive` used to carry this and meant the same thing as "not hidden", which is two fields for
   * one fact — the failure mode being a service live on one screen and paused on another. The
   * column is kept for one release so an older client's `isActive: false` still means hidden.
   */
  ownerState ServiceOwnerState @default(LIVE) @map("owner_state")
  isActive   Boolean           @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  bookings   Booking[]
  updates    ServiceUpdate[]
  milestones ServiceMilestone[]
  packages   ServicePackage[]

  // Never hard-deleted while a booking references it, or the booking loses its own subject (2.6.3).

  /// Whether the public can see this (§6.5). Mirrors `ContentSafety.visibilityState`, and this is
  /// the copy every read path filters on — one column on the table being queried, rather than a
  /// join against a polymorphic safety table on every feed page.
  visibilityState ContentVisibilityState @default(VISIBLE) @map("visibility_state")

  @@index([listingId, isActive])
  @@index([listingId, ownerState])
  /// What the category browse and the service search filter on, before relevance.
  @@index([categoryCode, subcategoryCode])
  // Trigram search over what members actually type (v2 §6.1).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "professional_services_name_trgm_idx")
  @@map("professional_services")
}

/// A note a professional posts against one service: a fee change, a seasonal closure (v2 §5.3).
/// Self-reported and unverified, and presented that way — it sits near a Circl-verified chip and
/// must not borrow its authority.
model ServiceUpdate {
  id        String              @id @default(uuid())
  serviceId String              @map("service_id")
  service   ProfessionalService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  title String? @map("title")
  body  String  @map("body")

  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz
  sort        Int      @default(0) @map("sort")

  @@index([serviceId, publishedAt])
  @@map("service_updates")
}

/// A claim about the work: "200 applications supported" (v2 §5.3). `year` and `issuer` are
/// nullable and an absent year must read as absent — "… · 0" is worse than the claim alone.
model ServiceMilestone {
  id        String              @id @default(uuid())
  serviceId String              @map("service_id")
  service   ProfessionalService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  label  String  @map("label")
  year   Int?    @map("year")
  issuer String? @map("issuer")
  sort   Int     @default(0) @map("sort")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([serviceId, sort])
  @@map("service_milestones")
}

/**
 * One named option on a service priced in packages: a name, a price, and a sentence.
 *
 * Its own table rather than JSON on the service, because `sort` is the professional's own ordering
 * and has to be queryable, and because the cheapest package is read on every write to recompute
 * the service's headline price.
 *
 * Deliberately **no** type enum, duration, availability or deliverables. There is no
 * Bronze/Silver/Gold: the work decides what the tiers are, and a vocabulary we invented would be
 * one professionals have to write around.
 */
model ServicePackage {
  id        String              @id @default(uuid())
  serviceId String              @map("service_id")
  service   ProfessionalService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  name        String  @map("name")
  /// Pence, greater than zero. A package carries no currency of its own — the service says.
  pricePence  Int     @map("price_pence")
  description String? @map("description")
  /// The professional's own order, which is meaningful: they decide which option is read first.
  /// Returned in it, and never sorted by price or by name on the way out.
  sort        Int     @default(0) @map("sort")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  bookings Booking[]

  @@index([serviceId, sort])
  @@map("service_packages")
}

/// A coded skill on a listing (v2 §4.1). `TaxonomyKind.SKILL`.
model ProfessionalListingSkill {
  listingId String              @map("listing_id")
  listing   ProfessionalListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  code      String              @map("code")
  sort      Int                 @default(0) @map("sort")

  @@id([listingId, code])
  @@index([code])
  @@map("professional_listing_skills")
}

/// When a professional can be contacted (v2 §4.2). Exactly seven rows per listing, Monday first —
/// the same shape as a store's opening hours, read by the same clock, because `isContactableNow`
/// and any `contactableNow` filter must never be two implementations of one question.
model ProfessionalContactHours {
  listingId String              @map("listing_id")
  listing   ProfessionalListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  day       Weekday             @map("day")

  openMinutes  Int? @map("open_minutes")
  closeMinutes Int? @map("close_minutes")

  @@id([listingId, day])
  @@map("professional_contact_hours")
}

/**
 * Did a reviewer read this person's documents for this category (v2 §2).
 * One record per `(professional, category)` — never per listing, never per service. That is the
 * structural change: one approval covers every service that professional ever lists in that
 * category, so the record cannot hang off a service, and it survives the listing being edited.
 * Keyed on the **user** rather than the listing because the professional is the person: a listing
 * rebuilt from scratch must not lose a licence check somebody already passed, and a verification
 * may be submitted before the category is even on their profile (§2.4).
 * Distinct from `TrustCheck` on purpose and for ever. That asks whether somebody is who they say
 * they are; this asks whether they may practise in one field. A member verified for Immigration
 * who also sells web design must not appear to have had the web design checked.
 */
model CategoryVerification {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// `TaxonomyKind.PROFESSION` — the category, not the subcategory.
  categoryCode String @map("category_code")

  status CategoryVerificationStatus @default(PENDING) @map("status")

  /**
   * What the documents were submitted *under* (§2.3).
   * It does not scope the approval — approval is category-wide, which is the product owner's
   * stated rule — but it is stored because it is the only thing that would make a narrower scope
   * possible later without a migration. Together with `licenceSeen` it is the mitigation for an
   * IAA registration unlocking *Immigration solicitor*.
   */
  submittedForSubcategories String[] @map("submitted_for_subcategories")

  /// The member's own words with the submission, ≤ 500 characters.
  note String? @map("note")

  submittedAt DateTime  @default(now()) @map("submitted_at") @db.Timestamptz
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz
  decidedById String?   @map("decided_by_id")

  /// The reviewer's words, shown to the member **verbatim** on a decline. It is the only thing
  /// that tells somebody what to fix, so it is never summarised or templated on the way out.
  decisionNote String? @map("decision_note")

  /// Which licence or registration the reviewer actually saw — free text, staff-only, and the
  /// record that makes category-wide approval auditable (§2.3, §12).
  licenceSeen String? @map("licence_seen")

  /// Who the member is told checked it. "Circl Trust & Safety" rather than a person's name.
  checkedBy String? @map("checked_by")

  /// Nullable, and null means it does not lapse. A renewal date is the normal case in regulated
  /// work, so the field exists from the start rather than arriving as a backfill.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([userId, categoryCode])
  /// The review queue's own ordering: oldest submission first, within a state.
  @@index([status, submittedAt])
  @@index([categoryCode, status])
  @@map("category_verifications")
}

// ─── Managed briefs and Smart Match (Circl Intelligence) ─────────────────────

/**
 * "Let Circl handle it" — a member describing a problem they cannot name a professional for.
 * Still `managed_briefs` in the database, because the columns are the same ones and a table rename
 * buys nothing a reader of this file cannot see. What changed is the theory: this used to feed a
 * scoring matcher (`BriefMatch`), and now it feeds a person. A member describes the problem, staff
 * read it and offer it to professionals they judge suitable, and up to three of them introduce
 * themselves. The value is that a human did the thinking, so nothing here ranks anybody.
 */
model ServiceRequest {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  /**
   * The member's own guess, and optional on purpose.
   * Absent means "I do not know what I need", which is the whole reason this route exists: asking
   * somebody to classify their own problem is the thing browsing already fails at. It is never
   * defaulted and never rejected.
   */
  categoryCode String? @map("category_code")

  /**
   * The category staff decided on, held separately from the member's guess.
   * Two columns rather than one overwritten field, so nobody later mistakes a member's hunch for
   * Circl's judgement — and so a wrong guess can be corrected without erasing what they said.
   */
  adminCategoryCode String? @map("admin_category_code")

  description String       @map("description")
  urgency     BriefUrgency @default(FLEXIBLE) @map("urgency")

  /// Pence, display only, and only ever set when the member typed a single figure.
  budget   Int?   @map("budget")
  currency String @default("GBP") @map("currency")

  /**
   * What the member actually typed, when it was not a single figure.
   * The form takes words — "Under 50", "50-100", "Flexible" — and the wire took pence, so anything
   * that was not one number could not travel and staff never learned the member had mentioned a
   * budget at all. Held verbatim and shown to staff as typed. Nothing parses it, and nothing
   * should: "50-100" read as £50,100 is the bug this column exists to end.
   */
  budgetText String? @map("budget_text")

  /// Taken from the member's profile at submission: there is no city picker on this screen, and
  /// staff need it to search, so asking somebody to restate where they live is a question the
  /// account already answers.
  cityId String? @map("city_id")
  city   City?   @relation(fields: [cityId], references: [id])

  state ServiceRequestState @default(SUBMITTED) @map("state")

  /**
   * Circl's own sentence to the member, shown under the status. Never templated.
   * This is where "we have asked two agencies" goes — the half of the outcome a status word cannot
   * carry.
   */
  note String? @map("note")

  /// When staff sent the outcome, and who. The pipeline's own clock: a request with offers out and
  /// no outcome is one somebody still owes an answer on.
  outcomeSentAt DateTime? @map("outcome_sent_at") @db.Timestamptz
  outcomeById   String?   @map("outcome_by_id")

  /// The Smart Match leftovers (deprecated). Written only by the superseded `briefs` endpoints,
  /// which answer until the app that calls them is gone.
  chosenListingId String? @map("chosen_listing_id")
  bookingId       String? @map("booking_id")

  /// Who placed it, when staff did (§5.16).
  placedById String?   @map("placed_by_id")
  placedAt   DateTime? @map("placed_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  matches  BriefMatch[]
  bookings Booking[]
  offers   ServiceRequestOffer[]

  @@index([userId, state])
  /// The staff queue: newest first within a state.
  @@index([state, createdAt])
  @@map("managed_briefs")
}

/**
 * One request, offered to one professional (§2, professional side).
 * An offer, not an assignment: the professional still chooses, and the wording staff see says so.
 * The member is **not** named on it — they agreed to hear from professionals Circl chose, not to
 * have their name circulated to everyone who was asked. Their city travels, because judging
 * whether you can take something on without knowing where it is is guesswork.
 */
model ServiceRequestOffer {
  id        String         @id @default(uuid())
  requestId String         @map("request_id")
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  /// The professional's account, not their listing: the offer follows the person, and a listing
  /// can be taken down between the offer and the answer.
  professionalId String @map("professional_id")
  professional   User   @relation("ServiceRequestOffers", fields: [professionalId], references: [id], onDelete: Cascade)

  /// Which listing staff were looking at when they offered it. Display only, and nullable because
  /// the listing may be gone by the time anybody reads the row back.
  listingId String? @map("listing_id")

  status ServiceRequestOfferStatus @default(PENDING) @map("status")

  /// No foreign key, like every other staff reference: who offered this outlives the staff account.
  offeredById String   @map("offered_by_id")
  offeredAt   DateTime @default(now()) @map("offered_at") @db.Timestamptz

  /// Unanswered offers lapse rather than hold a request open for ever.
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  respondedAt DateTime? @map("responded_at") @db.Timestamptz

  /// Set on acceptance: the thread the professional's introduction was posted into.
  conversationId String? @map("conversation_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  /// One offer per professional per request. Offering twice is a mistake, not a second chance.
  @@unique([requestId, professionalId])
  /// Their own inbox, answered rows included.
  @@index([professionalId, status, offeredAt])
  /// "Who has answered" on the request, and the acceptance count the cap is read from.
  @@index([requestId, status])
  /// The expiry sweep reads exactly this.
  @@index([status, expiresAt])
  @@map("service_request_offers")
}

// Scores are 0..1 with a one-word qualifier computed server-side, so the four mini-bars and their labels agree everywhere (2.8.2).
model BriefMatch {
  id      String         @id @default(uuid())
  briefId String         @map("brief_id")
  brief   ServiceRequest @relation(fields: [briefId], references: [id], onDelete: Cascade)

  listingId String              @map("listing_id")
  listing   ProfessionalListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  rank          Int   @map("rank")
  totalScore    Float @map("total_score")
  ratingScore   Float @map("rating_score")
  distanceScore Float @map("distance_score")
  priceScore    Float @map("price_score")
  responseScore Float @map("response_score")
  priceForBrief Int?  @map("price_for_brief")

  // A plain sentence, or null.
  rationale String? @map("rationale")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([briefId, listingId])
  @@index([briefId, rank])
  @@map("brief_matches")
}

// ─── Bookings ────────────────────────────────────────────────────────────────

model Booking {
  id String @id @default(uuid())

  clientId String @map("client_id")
  client   User   @relation("BookingClient", fields: [clientId], references: [id], onDelete: Cascade)

  professionalId String @map("professional_id")
  professional   User   @relation("BookingProfessional", fields: [professionalId], references: [id], onDelete: Cascade)

  listingId String              @map("listing_id")
  listing   ProfessionalListing @relation(fields: [listingId], references: [id])

  serviceId String?              @map("service_id")
  service   ProfessionalService? @relation(fields: [serviceId], references: [id])

  /**
   * Which package of that service was booked, where it is priced in packages.
   *
   * A reference beside a snapshot, exactly as `serviceId` sits beside `serviceName`: the id is for
   * linkage and `packageName` is the record. `SetNull` rather than a cascade, because a package the
   * professional later deletes must not take a booking with it — the name and the price stay, so
   * what was agreed is still legible once the row it came from is gone.
   */
  packageId String?         @map("package_id")
  package   ServicePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  briefId String?         @map("brief_id")
  brief   ServiceRequest? @relation(fields: [briefId], references: [id])

  // Copied from the service or the brief at creation.
  serviceName        String  @map("service_name")
  serviceDescription String? @map("service_description")
  /// The chosen package's name, snapshotted. Null on a flat-rate service and on a brief.
  packageName        String? @map("package_name")
  /**
   * What the two of them are talking about, in pence.
   *
   * The chosen package's price where one was named, the service's price otherwise. Not a sum
   * anybody owes and not money Circl holds (D12) — but it has to be the figure the buyer actually
   * pressed, or the booking contradicts the page it came from.
   */
  quotedAmount       Int?    @map("quoted_amount")
  agreedAmount       Int?    @map("agreed_amount") // D12: a record, not financial data
  currency           String  @default("GBP") @map("currency")

  state JobState @default(PENDING_ACCEPTANCE) @map("state")

  preferredDate     DateTime?   @map("preferred_date") @db.Date
  preferredTimeSlot String?     @map("preferred_time_slot")
  isFlexible        Boolean     @default(false) @map("is_flexible")
  mode              BookingMode @default(ONLINE) @map("mode")
  address           String?     @map("address")
  details           String?     @map("details")

  conversationId String?       @map("conversation_id")
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  // 7 days after DELIVERED.
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz
  autoCompleteAt DateTime? @map("auto_complete_at") @db.Timestamptz
  completedAt    DateTime? @map("completed_at") @db.Timestamptz
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz
  cancelReason   String?   @map("cancel_reason")

  firstClientMessageAt DateTime? @map("first_client_message_at") @db.Timestamptz
  firstProReplyAt      DateTime? @map("first_pro_reply_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  events   BookingEvent[]
  disputes Dispute[]
  reviews  Review[]

  @@index([clientId, state, createdAt])
  @@index([professionalId, state, createdAt])
  @@index([state, autoCompleteAt])
  @@map("bookings")
}

// The timeline is data, not a client-side derivation, because each stage is timestamped and the client must not have to invent the order (2.9.1).
model BookingEvent {
  id        String  @id @default(uuid())
  bookingId String  @map("booking_id")
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  stage    JobStage @map("stage")
  actorId  String?  @map("actor_id")
  note     String?  @map("note")
  metadata Json?    @map("metadata")

  reachedAt DateTime @default(now()) @map("reached_at") @db.Timestamptz

  @@unique([bookingId, stage])
  @@index([bookingId, reachedAt])
  @@map("booking_events")
}

// ─── Disputes ────────────────────────────────────────────────────────────────

// One dispute resource, polymorphic on subject, shared by bookings and commerce enquiries (4.1.3) so "Report a problem" behaves the same wherever it is raised.
model Dispute {
  id String @id @default(uuid())

  subjectType DisputeSubjectType @map("subject_type")
  bookingId   String?            @map("booking_id")
  booking     Booking?           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  enquiryId   String?            @map("enquiry_id")
  enquiry     Enquiry?           @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  raisedById String @map("raised_by_id")
  raisedBy   User   @relation(fields: [raisedById], references: [id], onDelete: Cascade)

  reasonCode  DisputeReason @map("reason_code")
  description String        @map("description")
  state       DisputeState  @default(OPEN) @map("state")

  conversationId String?       @map("conversation_id")
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  /// Whose work this is (§5.17).
  assignedToId String?   @map("assigned_to_id")
  assignedAt   DateTime? @map("assigned_at") @db.Timestamptz

  expectedResolutionAt DateTime?       @map("expected_resolution_at") @db.Timestamptz
  resolvedAt           DateTime?       @map("resolved_at") @db.Timestamptz
  /// The finding. `resolutionNote` is what both parties read, and this is what the platform
  /// concluded — kept apart because one is prose written for two members in a disagreement and the
  /// other is the value a chart counts.
  outcome              DisputeOutcome? @map("outcome")
  resolutionNote       String?         @map("resolution_note")
  resolvedById         String?         @map("resolved_by_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  evidence DisputeEvidence[]

  @@index([state, createdAt])
  @@index([bookingId])
  @@index([enquiryId])
  @@index([assignedToId, state])
  @@map("disputes")
}

// "Both of you can add evidence" is promised on the screen, so it has to be true after submission and not only during (2.10).
model DisputeEvidence {
  id        String  @id @default(uuid())
  disputeId String  @map("dispute_id")
  dispute   Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  submittedById String @map("submitted_by_id")
  submittedBy   User   @relation(fields: [submittedById], references: [id], onDelete: Cascade)

  note      String?  @map("note")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([disputeId])
  @@map("dispute_evidence")
}

// ─── Managed requests (shared with Commerce, 4.10) ───────────────────────────

model ManagedRequest {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectType ManagedRequestSubject @map("subject_type")
  state       ManagedRequestState   @default(OPEN) @map("state")

  helpAreas Json?   @map("help_areas")
  notes     String? @map("notes")
  storeId   String? @map("store_id")
  briefId   String? @map("brief_id")

  /// Whose work this is (§5.16). No foreign key, like every other staff reference in the admin
  /// surface: the record of who handled a member's request outlives the staff account that did.
  assignedToId String?   @map("assigned_to_id")
  assignedAt   DateTime? @map("assigned_at") @db.Timestamptz

  /// Required to close (§7.7). "Closed" with no reason is a pipeline that cannot be reported on:
  /// a request that ended because we placed the member and one that ended because we could not
  /// help are the same row otherwise, and they are the two numbers this pipeline exists to produce.
  closedReason ManagedRequestClosedReason? @map("closed_reason")
  closedAt     DateTime?                   @map("closed_at") @db.Timestamptz

  conversationId String?       @map("conversation_id")
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([state, createdAt])
  @@index([userId])
  /// The pipeline's own filter: "my open requests" and "nobody's yet".
  @@index([assignedToId, state])
  @@map("managed_requests")
}

/// The working week behind the booking slot picker (G5). Without it the app offers the same six
/// days and eight times for every professional, forever.
model ListingAvailability {
  listingId String              @map("listing_id")
  listing   ProfessionalListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  day       Weekday             @map("day")

  /// Minutes from midnight, the same unit the store opening hours use.
  startMinutes Int @map("start_minutes")
  endMinutes   Int @map("end_minutes")
  /// How long one bookable slot runs for, so an hour-long consultation and a 30-minute call differ.
  slotMinutes  Int @default(60) @map("slot_minutes")

  @@id([listingId, day])
  @@map("listing_availability")
}

/// A single day the professional is not working: holiday, or a date they blocked out.
model ListingAvailabilityBlock {
  id        String              @id @default(uuid())
  listingId String              @map("listing_id")
  listing   ProfessionalListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  date   DateTime @map("date") @db.Date
  reason String?  @map("reason")

  @@unique([listingId, date])
  @@index([listingId, date])
  @@map("listing_availability_blocks")
}
